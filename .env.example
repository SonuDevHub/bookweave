PORT=5000
NODE_ENV=production

# Local development origins; in production set your live domain(s)
CLIENT_URL=http://localhost:5173,http://localhost:5000
FRONTEND_URL=http://localhost:5000
# Production example:
# CLIENT_URL=https://thebookweave.com,https://www.thebookweave.com
# FRONTEND_URL=https://thebookweave.com

MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/bookweave?retryWrites=true&w=majority
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
JWT_SECRET=replace-with-a-long-random-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

ENQUIRY_ADMIN_EMAIL=your-email@gmail.com
