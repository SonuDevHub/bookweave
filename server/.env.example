# Server
PORT=5000
NODE_ENV=production

# Comma-separated allowed frontend origins (optional when served from the same domain)
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/bookweave

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary (required for book cover & author photo uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP Email (required for enquiry notifications and admin OTP password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="BookWeave <noreply@example.com>"
ENQUIRY_ADMIN_EMAIL=admin@example.com

# Initial admin seed script (server/scripts/createAdmin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password


